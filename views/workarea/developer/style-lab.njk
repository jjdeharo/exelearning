{% extends "base.njk" %}

{% block title %}Style Lab — Developer{% endblock %}

{% block stylesheets %}
{{ super() }}
<style>
    :root {
        --sl-sidebar-width: 280px;
        --sl-header-height: 48px;
        --sl-border: #dee2e6;
        --sl-bg-sidebar: #f8f9fa;
        --sl-accent: #0d6efd;
    }

    * { box-sizing: border-box; }

    body {
        margin: 0;
        font-family: system-ui, sans-serif;
        font-size: 14px;
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
        background: #fff;
    }

    #sl-header {
        height: var(--sl-header-height);
        background: #212529;
        color: #fff;
        display: flex;
        align-items: center;
        padding: 0 16px;
        gap: 12px;
        flex-shrink: 0;
        border-bottom: 1px solid #343a40;
    }

    #sl-header a { color: #adb5bd; text-decoration: none; font-size: 13px; }
    #sl-header a:hover { color: #fff; }
    #sl-header .sep { color: #495057; }
    #sl-header h1 { font-size: 14px; font-weight: 600; margin: 0; color: #fff; }

    #sl-badge {
        background: #198754;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    #sl-main { display: flex; flex: 1; overflow: hidden; }

    #sl-sidebar {
        width: var(--sl-sidebar-width);
        background: var(--sl-bg-sidebar);
        border-right: 1px solid var(--sl-border);
        overflow-y: auto;
        flex-shrink: 0;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .sl-section { display: flex; flex-direction: column; gap: 6px; }

    .sl-section label {
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #6c757d;
    }

    .sl-section select {
        width: 100%;
        padding: 6px 8px;
        border: 1px solid #ced4da;
        border-radius: 6px;
        font-size: 13px;
        background: #fff;
    }

    .sl-section select:focus {
        outline: none;
        border-color: var(--sl-accent);
        box-shadow: 0 0 0 3px rgba(13,110,253,.15);
    }

    .sl-btn-group { display: flex; gap: 4px; }

    .sl-btn-group button {
        flex: 1;
        padding: 6px 4px;
        border: 1px solid #ced4da;
        border-radius: 6px;
        background: #fff;
        font-size: 12px;
        cursor: pointer;
        transition: background .15s, border-color .15s;
    }

    .sl-btn-group button.active,
    .sl-btn-group button:hover {
        background: var(--sl-accent);
        border-color: var(--sl-accent);
        color: #fff;
    }

    /* Export Options checkboxes */
    .sl-options-grid {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .sl-option {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #495057;
        cursor: pointer;
        padding: 3px 0;
    }

    .sl-option input[type="checkbox"] { cursor: pointer; accent-color: var(--sl-accent); }

    #sl-actions {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: auto;
        padding-top: 12px;
        border-top: 1px solid var(--sl-border);
    }

    #sl-actions button {
        width: 100%;
        padding: 8px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        border: 1px solid transparent;
        transition: opacity .15s;
    }

    #sl-actions button:disabled { opacity: .5; cursor: not-allowed; }

    #btn-preview { background: var(--sl-accent); color: #fff; border-color: var(--sl-accent); }
    #btn-open-window { background: #fff; border-color: #ced4da; }
    #btn-reload-theme { background: #fff; border-color: #ced4da; color: #6c757d; font-size: 12px; }

    #sl-preview { flex: 1; display: flex; flex-direction: column; background: #e9ecef; overflow: hidden; }

    #sl-viewport-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 8px 16px;
        background: #fff;
        border-bottom: 1px solid var(--sl-border);
        flex-shrink: 0;
    }

    #sl-viewport-bar button {
        padding: 4px 12px;
        border: 1px solid #ced4da;
        border-radius: 20px;
        background: #fff;
        font-size: 12px;
        cursor: pointer;
    }

    #sl-viewport-bar button.active { background: #212529; border-color: #212529; color: #fff; }

    #sl-iframe-wrap {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        overflow: auto;
        transition: all .3s;
    }

    #sl-iframe-wrap.vp-desktop { padding: 0; }
    #sl-iframe-wrap.vp-tablet  { padding: 16px; }
    #sl-iframe-wrap.vp-mobile  { padding: 32px; }

    #sl-iframe {
        width: 100%;
        height: 100%;
        border: none;
        background: #fff;
        transition: width .3s, height .3s, border-radius .3s;
    }

    #sl-iframe-wrap.vp-tablet #sl-iframe { max-width: 768px; border-radius: 4px; box-shadow: 0 4px 24px rgba(0,0,0,.15); }
    #sl-iframe-wrap.vp-mobile #sl-iframe { max-width: 390px; border-radius: 8px; box-shadow: 0 4px 24px rgba(0,0,0,.2); }

    #sl-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #6c757d;
        font-size: 14px;
        height: 100%;
        width: 100%;
    }

    #sl-placeholder svg { opacity: .3; }

    #sl-status {
        font-size: 11px;
        color: #6c757d;
        text-align: center;
        padding: 4px 8px;
        background: #fff;
        border-top: 1px solid var(--sl-border);
        flex-shrink: 0;
    }

    .sl-loading { opacity: .6; pointer-events: none; }
</style>
{% endblock %}

{% block body %}
<div id="sl-header">
    <a href="{{ basePath }}/workarea">← eXeLearning</a>
    <span class="sep">/</span>
    <h1>Style Lab</h1>
    <span id="sl-badge">dev</span>
</div>

<div id="sl-main">
    <aside id="sl-sidebar">

        <div class="sl-section">
            <label>Fixture</label>
            <select id="sl-fixture" data-testid="style-lab-fixture">
                <option value="">— select —</option>
            </select>
        </div>

        <div class="sl-section">
            <label>Theme</label>
            <select id="sl-theme" data-testid="style-lab-theme">
                <option value="">— loading —</option>
            </select>
        </div>

        <div class="sl-section">
            <label>Export type</label>
            <div class="sl-btn-group" data-testid="style-lab-export-type">
                <button class="active" data-export="html5">Website</button>
                <button data-export="html5-sp">Single page</button>
                <button data-export="scorm12">SCORM 1.2</button>
            </div>
        </div>

        <div class="sl-section">
            <label>Export options</label>
            <div class="sl-options-grid" data-testid="style-lab-export-options">
                <label class="sl-option">
                    <input type="checkbox" id="opt-searchBox" data-meta="addSearchBox" data-testid="opt-searchBox">
                    Search box
                </label>
                <label class="sl-option">
                    <input type="checkbox" id="opt-pagination" data-meta="addPagination" data-testid="opt-pagination">
                    Page counter
                </label>
                <label class="sl-option">
                    <input type="checkbox" id="opt-accessibility" data-meta="addAccessibilityToolbar" data-testid="opt-accessibility">
                    Accessibility toolbar
                </label>
                <label class="sl-option">
                    <input type="checkbox" id="opt-exeLink" data-meta="addExeLink" checked data-testid="opt-exeLink">
                    eXeLearning link
                </label>
                <label class="sl-option">
                    <input type="checkbox" id="opt-exportSource" data-meta="exportSource" checked data-testid="opt-exportSource">
                    Include source
                </label>
            </div>
        </div>

        <div id="sl-actions">
            <button id="btn-preview" data-testid="style-lab-preview-btn" disabled>Preview</button>
            <button id="btn-open-window" data-testid="style-lab-open-window" disabled>Open in new window</button>
            <button id="btn-reload-theme" data-testid="style-lab-reload-theme" title="Re-read theme files from disk and regenerate preview">↺ Reload theme from disk</button>
        </div>
    </aside>

    <div id="sl-preview">
        <div id="sl-viewport-bar">
            <button class="active" data-viewport="desktop" data-testid="vp-desktop">Desktop</button>
            <button data-viewport="tablet" data-testid="vp-tablet">Tablet</button>
            <button data-viewport="mobile" data-testid="vp-mobile">Mobile</button>
        </div>

        <div id="sl-iframe-wrap" class="vp-desktop">
            <div id="sl-placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 3h18v14H3zm16 12V5H5v10h14zM1 18h22v2H1z"/>
                </svg>
                <span>Select a fixture and theme, then click <strong>Preview</strong></span>
            </div>
            <iframe id="sl-iframe" style="display:none" data-testid="style-lab-iframe"></iframe>
        </div>

        <div id="sl-status" data-testid="style-lab-status">Ready</div>
    </div>
</div>

<script src="{{ ('/libs/fflate/fflate.umd.js') | asset }}"></script>
<script>
(function () {
    const basePath = {{ basePath | json }};
    const viewerUrl = basePath + '/viewer/index.html';
    let swRegistration = null;
    let previewReady = false;
    let selectedExport = 'html5';

    // ─── URL state helpers ────────────────────────────────────────────────────

    function getParams() {
        return new URLSearchParams(location.search);
    }

    function pushParams(patch) {
        const p = getParams();
        for (const [k, v] of Object.entries(patch)) {
            if (v === null || v === undefined) p.delete(k);
            else p.set(k, String(v));
        }
        history.replaceState(null, '', '?' + p.toString());
    }

    // ─── Service Worker ───────────────────────────────────────────────────────

    async function ensureServiceWorker() {
        if (!navigator.serviceWorker) throw new Error('Service Workers not supported');
        if (swRegistration) return swRegistration;

        const scope = basePath + '/viewer/';
        const swPath = basePath + '/preview-sw.js';

        const existing = await navigator.serviceWorker.getRegistration(scope);
        if (existing?.active) { swRegistration = existing; return swRegistration; }

        swRegistration = await navigator.serviceWorker.register(swPath, { scope });
        await new Promise(resolve => {
            if (swRegistration.active) { resolve(); return; }
            const worker = swRegistration.installing || swRegistration.waiting;
            if (worker) worker.addEventListener('statechange', () => { if (worker.state === 'activated') resolve(); });
            else resolve();
        });
        return swRegistration;
    }

    function getActiveSW() {
        return swRegistration?.active || navigator.serviceWorker?.controller || null;
    }

    async function sendToSW(files) {
        const sw = getActiveSW();
        if (!sw) throw new Error('No active Service Worker');
        return new Promise((resolve, reject) => {
            const ch = new MessageChannel();
            const timeout = setTimeout(() => reject(new Error('SW timeout')), 15000);
            ch.port1.onmessage = e => {
                clearTimeout(timeout);
                if (e.data?.type === 'CONTENT_READY') resolve(e.data.fileCount);
                else reject(new Error('SW error: ' + JSON.stringify(e.data)));
            };
            const transferables = [ch.port2];
            for (const v of Object.values(files)) {
                if (v instanceof ArrayBuffer) transferables.push(v);
            }
            sw.postMessage({ type: 'SET_CONTENT', data: { files, options: { openExternalLinksInNewWindow: true } } }, transferables);
        });
    }

    // ─── Data loading ─────────────────────────────────────────────────────────

    async function loadFixtures(selectValue) {
        const sel = document.getElementById('sl-fixture');
        try {
            const res = await fetch(`${basePath}/api/developer/fixtures`);
            const { fixtures } = await res.json();
            sel.innerHTML = '<option value="">— select fixture —</option>' +
                fixtures.map(f => `<option value="${f}"${f === selectValue ? ' selected' : ''}>${f}</option>`).join('');
        } catch {
            sel.innerHTML = '<option value="">Error loading fixtures</option>';
        }
    }

    async function loadThemes(selectValue) {
        const sel = document.getElementById('sl-theme');
        try {
            const res = await fetch(`${basePath}/api/themes/installed`);
            const { themes } = await res.json();
            sel.innerHTML = '<option value="">— select theme —</option>' +
                themes.map(t => {
                    const selected = selectValue ? t.dirName === selectValue : t.isDefault;
                    return `<option value="${t.dirName}"${selected ? ' selected' : ''}>${t.displayName}</option>`;
                }).join('');
        } catch {
            sel.innerHTML = '<option value="">Error loading themes</option>';
        }
    }

    // ─── UI interactions ──────────────────────────────────────────────────────

    document.querySelectorAll('[data-export]').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('[data-export]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            selectedExport = btn.dataset.export;
            pushParams({ export: selectedExport });
        });
    });

    document.querySelectorAll('[data-viewport]').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('[data-viewport]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('sl-iframe-wrap').className = `vp-${btn.dataset.viewport}`;
            pushParams({ viewport: btn.dataset.viewport });
        });
    });

    document.getElementById('sl-fixture').addEventListener('change', e => {
        pushParams({ fixture: e.target.value || null });
        updateActions();
    });

    document.getElementById('sl-theme').addEventListener('change', e => {
        pushParams({ theme: e.target.value || null });
        updateActions();
    });

    // Export option checkboxes: update URL and re-preview automatically
    document.querySelectorAll('[data-meta]').forEach(cb => {
        cb.addEventListener('change', () => {
            pushParams({ [cb.dataset.meta]: cb.checked ? '1' : '0' });
            if (previewReady) runPreview();
        });
    });

    function updateActions() {
        const fixture = document.getElementById('sl-fixture').value;
        const theme = document.getElementById('sl-theme').value;
        document.getElementById('btn-preview').disabled = !(fixture && theme);
        document.getElementById('btn-open-window').disabled = !previewReady;
    }

    // ─── Preview ──────────────────────────────────────────────────────────────

    async function runPreview() {
        const fixture = document.getElementById('sl-fixture').value;
        const theme = document.getElementById('sl-theme').value;
        if (!fixture || !theme) return;

        setStatus('Generating preview…');
        setLoading(true);

        try {
            await ensureServiceWorker();

            const url = new URL(`${basePath}/api/developer/style-lab/preview`, location.href);
            url.searchParams.set('fixture', fixture);
            url.searchParams.set('theme', theme);
            url.searchParams.set('exportType', selectedExport);

            // Append export option overrides
            document.querySelectorAll('[data-meta]').forEach(cb => {
                url.searchParams.set(cb.dataset.meta, cb.checked ? '1' : '0');
            });

            setStatus('Fetching export…');
            const res = await fetch(url.toString());
            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.message || res.statusText);
            }

            setStatus('Decompressing…');
            const zipBuffer = await res.arrayBuffer();
            const zipData = window.fflate.unzipSync(new Uint8Array(zipBuffer));

            const files = {};
            for (const [filePath, data] of Object.entries(zipData)) {
                files[filePath] = data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength);
            }

            setStatus('Sending to Service Worker…');
            const fileCount = await sendToSW(files);

            previewReady = true;
            updateActions();
            showPreview();
            setStatus(`${fileCount} files · ${fixture} · ${theme} · ${selectedExport}`);
        } catch (e) {
            setStatus(`Error: ${e.message}`);
            console.error('[Style Lab]', e);
        } finally {
            setLoading(false);
        }
    }

    document.getElementById('btn-preview').addEventListener('click', runPreview);

    document.getElementById('btn-open-window').addEventListener('click', () => {
        if (previewReady) window.open(viewerUrl, '_blank');
    });

    // Reload from disk: re-reads CSS from filesystem on next export (files are static, no cache)
    document.getElementById('btn-reload-theme').addEventListener('click', async () => {
        try {
            await fetch(`${basePath}/api/developer/reload-theme`, { method: 'POST' });
        } catch { /* ignore */ }
        if (previewReady || (document.getElementById('sl-fixture').value && document.getElementById('sl-theme').value)) {
            runPreview();
        } else {
            setStatus('Select fixture and theme first.');
        }
    });

    // ─── Helpers ──────────────────────────────────────────────────────────────

    function showPreview() {
        const iframe = document.getElementById('sl-iframe');
        const placeholder = document.getElementById('sl-placeholder');
        if (iframe.src && iframe.src.endsWith('/viewer/index.html')) {
            iframe.src = 'about:blank';
            setTimeout(() => { iframe.src = viewerUrl; }, 30);
        } else {
            iframe.src = viewerUrl;
        }
        iframe.style.display = '';
        placeholder.style.display = 'none';
    }

    function setStatus(msg) { document.getElementById('sl-status').textContent = msg; }
    function setLoading(on) { document.getElementById('sl-sidebar').classList.toggle('sl-loading', on); }

    // ─── Apply URL params on load ─────────────────────────────────────────────

    function applyUrlParams() {
        const p = getParams();

        // Export type
        const exportParam = p.get('export');
        if (exportParam) {
            document.querySelectorAll('[data-export]').forEach(btn => {
                const active = btn.dataset.export === exportParam;
                btn.classList.toggle('active', active);
                if (active) selectedExport = exportParam;
            });
        }

        // Viewport
        const viewportParam = p.get('viewport');
        if (viewportParam) {
            document.querySelectorAll('[data-viewport]').forEach(btn => {
                const active = btn.dataset.viewport === viewportParam;
                btn.classList.toggle('active', active);
                if (active) document.getElementById('sl-iframe-wrap').className = `vp-${viewportParam}`;
            });
        }

        // Export options
        document.querySelectorAll('[data-meta]').forEach(cb => {
            const val = p.get(cb.dataset.meta);
            if (val !== null) cb.checked = val === '1' || val === 'true';
        });

        return { fixture: p.get('fixture'), theme: p.get('theme') };
    }

    // ─── Init ─────────────────────────────────────────────────────────────────

    async function init() {
        const { fixture, theme } = applyUrlParams();
        await Promise.all([loadFixtures(fixture), loadThemes(theme)]);
        updateActions();

        // Auto-preview when all required params come from the URL
        if (fixture && theme) runPreview();

        // Pre-register SW in background
        if (navigator.serviceWorker) ensureServiceWorker().catch(() => {});
    }

    init();
})();
</script>
{% endblock %}
