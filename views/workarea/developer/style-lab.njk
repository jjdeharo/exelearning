<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
<script>
(function () {
    const basePath = {{ basePath | json | safe }};
    const viewerUrl = basePath + '/viewer/index.html';
    const T = {
        undone:               {{ t.sl_js_undone | json | safe }},
        redone:               {{ t.sl_js_redone | json | safe }},
        open_project:         {{ t.sl_js_open_project | json | safe }},
        fixtures:             {{ t.sl_js_fixtures | json | safe }},
        error_loading:        {{ t.sl_js_error_loading | json | safe }},
        select_theme:         {{ t.sl_js_select_theme | json | safe }},
        css_applied:          {{ t.sl_js_css_applied | json | safe }},
        css_reset:            {{ t.sl_js_css_reset | json | safe }},
        scope_all:            {{ t.sl_js_scope_all | json | safe }},
        select_css_first:     {{ t.sl_js_select_css_first | json | safe }},
        wrapped:              {{ t.sl_js_wrapped | json | safe }},
        rule_added:           {{ t.sl_js_rule_added | json | safe }},
        inspect_hint:         {{ t.sl_js_inspect_hint | json | safe }},
        ready:                {{ t.sl_js_ready | json | safe }},
        load_preview_first:   {{ t.sl_js_load_preview_first | json | safe }},
        select_theme_first:   {{ t.sl_js_select_theme_first | json | safe }},
        fill_name_id:         {{ t.sl_js_fill_name_id | json | safe }},
        id_invalid:           {{ t.sl_js_id_invalid | json | safe }},
        capturing:            {{ t.sl_js_capturing | json | safe }},
        installing:           {{ t.sl_js_installing | json | safe }},
        theme_applied:        {{ t.sl_js_theme_applied | json | safe }},
        theme_no_apply:       {{ t.sl_js_theme_installed_no_apply | json | safe }},
        theme_installed:      {{ t.sl_js_theme_installed | json | safe }},
        exporting:            {{ t.sl_js_exporting | json | safe }},
        downloaded:           {{ t.sl_js_downloaded | json | safe }},
        error_deleting:       {{ t.sl_js_error_deleting | json | safe }},
        error_deleting_theme: {{ t.sl_js_error_deleting_theme | json | safe }},
        theme_deleted:        {{ t.sl_js_theme_deleted | json | safe }},
        generating:           {{ t.sl_js_generating | json | safe }},
        fetching:             {{ t.sl_js_fetching | json | safe }},
        decompressing:        {{ t.sl_js_decompressing | json | safe }},
        sending_sw:           {{ t.sl_js_sending_sw | json | safe }},
        select_fixture_theme: {{ t.sl_js_select_fixture_theme | json | safe }},
        confirm_unsaved:      {{ t.sl_js_confirm_unsaved | json | safe }},
        confirm_discard:      {{ t.sl_js_confirm_discard | json | safe }},
        confirm_delete:       {{ t.sl_js_confirm_delete | json | safe }},
        install_apply_title:  {{ t.sl_install_apply_title | json | safe }},
        no_session_title:     {{ t.sl_no_session_title | json | safe }},
        reading_zip:          {{ t.sl_js_reading_zip | json | safe }},
        uploading_theme:      {{ t.sl_js_uploading_theme | json | safe }},
        theme_uploaded:       {{ t.sl_js_theme_uploaded | json | safe }},
        no_file_selected:     {{ t.sl_no_file_selected | json | safe }},
    };
    const QUICK_BLOCK_START = '/* style-lab-quick:start */';
    const QUICK_BLOCK_END = '/* style-lab-quick:end */';
    const CLICK_BLOCK_START = '/* style-lab-click:start */';
    const CLICK_BLOCK_END = '/* style-lab-click:end */';
    let swRegistration = null;
    let previewReady = false;
    let selectedExport = 'html5';
    let loadedThemes = [];
    let loadedSessions = [];    // sessions with theme info
    let themeFiles = {};        // path → string
    let activeCssFile = 'style.css';
    let originalCss = '';
    let inspectMode = false;
    let clickEditSelector = '';
    let applyDebounce = 0;
    let quickState = {};        // collected from [data-quick] inputs
    let themeReloadToken = Date.now();

    // ─── Undo / Redo stacks ───────────────────────────────────
    const UNDO_MAX = 30;
    let undoStack = [];
    let redoStack = [];

    function updateUndoRedoBtns() {
        document.getElementById('btn-undo').disabled = undoStack.length === 0;
        document.getElementById('btn-redo').disabled = redoStack.length === 0;
    }

    function currentSnap() {
        return { css: document.getElementById('sl-css-textarea').value, qs: JSON.stringify(quickState) };
    }

    function applySnap(snap) {
        const ta = document.getElementById('sl-css-textarea');
        ta.value = snap.css;
        markModified(ta.value !== originalCss);
        updateHighlight();
        if (previewReady) injectEditorCss(snap.css);
        quickState = JSON.parse(snap.qs);
        document.querySelectorAll('[data-quick]').forEach(el => {
            const v = quickState[el.dataset.quick];
            if (v !== undefined) el.value = v;
        });
        if (previewReady) injectQuickCss(buildScopeWrapped(buildQuickCss(quickState)));
    }

    function pushUndo() {
        const snap = currentSnap();
        const last = undoStack[undoStack.length - 1];
        if (last && last.css === snap.css && last.qs === snap.qs) return;
        undoStack.push(snap);
        if (undoStack.length > UNDO_MAX) undoStack.shift();
        redoStack = []; // new action clears redo
        updateUndoRedoBtns();
    }

    function doUndo() {
        if (!undoStack.length) return;
        redoStack.push(currentSnap());
        applySnap(undoStack.pop());
        updateUndoRedoBtns();
        setStatus(T.undone);
    }

    function doRedo() {
        if (!redoStack.length) return;
        undoStack.push(currentSnap());
        applySnap(redoStack.pop());
        updateUndoRedoBtns();
        setStatus(T.redone);
    }

    document.getElementById('btn-undo').addEventListener('click', doUndo);
    document.getElementById('btn-redo').addEventListener('click', doRedo);

    // ─── CSS Scope ────────────────────────────────────────────
    const SCOPE_ALL = ['exe-web-site', 'exe-single-page', 'exe-scorm'];

    function getScopeClasses() {
        return [...document.querySelectorAll('#sl-scope-grid input:checked')].map(i => i.value);
    }

    function buildScopeWrapped(innerCss) {
        const classes = getScopeClasses();
        const trimmed = innerCss.trim();
        if (!trimmed) return '';
        if (classes.length === 0 || classes.length === SCOPE_ALL.length) return trimmed;
        const selector = classes.map(c => `body.${c}`).join(',\n');
        // indent each line of the inner CSS by 2 spaces
        const indented = trimmed.split('\n').map(l => l ? `  ${l}` : l).join('\n');
        return `${selector} {\n${indented}\n}`;
    }

    function saveScope() {
        localStorage.setItem('sl-scope-v2', JSON.stringify(getScopeClasses()));
    }

    function enforceScopeNotEmpty() {
        const chips = [...document.querySelectorAll('#sl-preview-toolbar .sl-scope-chip')];
        const anyChecked = chips.some(ch => ch.querySelector('input').checked);
        if (!anyChecked) {
            chips.forEach(ch => {
                ch.querySelector('input').checked = true;
                ch.classList.add('checked');
            });
        }
    }

    function loadScope() {
        try {
            const saved = JSON.parse(localStorage.getItem('sl-scope-v2') || 'null');
            if (Array.isArray(saved)) {
                document.querySelectorAll('#sl-preview-toolbar input[type="checkbox"]').forEach(cb => {
                    cb.checked = saved.includes(cb.value);
                    cb.closest('.sl-scope-chip').classList.toggle('checked', cb.checked);
                });
                enforceScopeNotEmpty();
            }
        } catch {}
    }

    document.querySelectorAll('#sl-preview-toolbar .sl-scope-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            const cb = chip.querySelector('input');
            cb.checked = !cb.checked;
            chip.classList.toggle('checked', cb.checked);
            enforceScopeNotEmpty();
            saveScope();
            if (previewReady) {
                if (Object.keys(quickState).length) {
                    injectQuickCss(buildScopeWrapped(buildQuickCss(quickState)));
                }
                injectEditorCss(document.getElementById('sl-css-textarea').value);
            }
        });
    });

    // ─── Controlled blocks ────────────────────────────────────
    function replaceControlledBlock(css, start, end, content) {
        const trimmed = String(content || '').trim();
        const block = trimmed ? `${start}\n${trimmed}\n${end}` : '';
        const escapeRe = value => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(`${escapeRe(start)}[\\s\\S]*?${escapeRe(end)}`);
        if (re.test(css)) {
            return css.replace(re, block).replace(/\n{3,}/g, '\n\n').trimEnd();
        }
        return block ? `${css.trimEnd()}\n\n${block}` : css;
    }

    function appendToControlledBlock(css, start, end, content) {
        const escapeRe = value => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(`${escapeRe(start)}\\n?([\\s\\S]*?)\\n?${escapeRe(end)}`);
        const existing = re.exec(css)?.[1]?.trim();
        const next = [existing, String(content || '').trim()].filter(Boolean).join('\n\n');
        return replaceControlledBlock(css, start, end, next);
    }

    // ─── Highlight.js for CSS editor ─────────────────────────
    function updateHighlight() {
        const code = document.querySelector('#sl-css-highlight code');
        const ta = document.getElementById('sl-css-textarea');
        code.textContent = ta.value;
        if (window.hljs) hljs.highlightElement(code);
        syncScroll();
    }

    function syncScroll() {
        const ta = document.getElementById('sl-css-textarea');
        const pre = document.getElementById('sl-css-highlight');
        pre.scrollTop = ta.scrollTop;
        pre.scrollLeft = ta.scrollLeft;
    }

    document.getElementById('sl-css-textarea').addEventListener('focus', pushUndo);
    document.getElementById('sl-css-textarea').addEventListener('input', () => {
        markModified(true);
        updateHighlight();
        clearTimeout(applyDebounce);
        applyDebounce = setTimeout(() => {
            if (previewReady) injectEditorCss(document.getElementById('sl-css-textarea').value);
        }, 600);
    });

    document.getElementById('sl-css-textarea').addEventListener('scroll', syncScroll);

    // ─── URL state ────────────────────────────────────────────
    function getParams() { return new URLSearchParams(location.search); }
    function pushParams(patch) {
        const p = getParams();
        for (const [k, v] of Object.entries(patch)) {
            if (v == null) p.delete(k); else p.set(k, String(v));
        }
        history.replaceState(null, '', '?' + p.toString());
    }

    // ─── Service Worker ───────────────────────────────────────
    async function ensureServiceWorker() {
        if (!navigator.serviceWorker) throw new Error('Service Workers not supported');
        if (swRegistration) return swRegistration;
        const scope = basePath + '/viewer/';
        const swPath = basePath + '/preview-sw.js';
        const existing = await navigator.serviceWorker.getRegistration(scope);
        if (existing?.active) { swRegistration = existing; return swRegistration; }
        swRegistration = await navigator.serviceWorker.register(swPath, { scope });
        await new Promise(resolve => {
            if (swRegistration.active) { resolve(); return; }
            const w = swRegistration.installing || swRegistration.waiting;
            if (w) w.addEventListener('statechange', () => { if (w.state === 'activated') resolve(); });
            else resolve();
        });
        return swRegistration;
    }

    async function sendToSW(files) {
        const sw = swRegistration?.active || navigator.serviceWorker?.controller;
        if (!sw) throw new Error('No active Service Worker');
        // Step 1: SET_CONTENT + wait for CONTENT_READY
        const fileCount = await new Promise((resolve, reject) => {
            const ch = new MessageChannel();
            const t = setTimeout(() => reject(new Error('SW timeout')), 15000);
            ch.port1.onmessage = e => {
                clearTimeout(t);
                if (e.data?.type === 'CONTENT_READY') resolve(e.data.fileCount);
                else reject(new Error(JSON.stringify(e.data)));
            };
            const trans = [ch.port2];
            for (const v of Object.values(files)) if (v instanceof ArrayBuffer) trans.push(v);
            sw.postMessage({ type: 'SET_CONTENT', data: { files, options: { openExternalLinksInNewWindow: true } } }, trans);
        });
        // Step 2: VERIFY_READY — needed for Firefox's stricter SW event timing
        await new Promise((resolve, reject) => {
            const ch = new MessageChannel();
            const t = setTimeout(() => reject(new Error('SW verify timeout')), 5000);
            ch.port1.onmessage = e => {
                clearTimeout(t);
                if (e.data?.ready) resolve();
                else reject(new Error('SW content not ready after verification'));
            };
            sw.postMessage({ type: 'VERIFY_READY' }, [ch.port2]);
        });
        return fileCount;
    }

    // ─── Data loading ─────────────────────────────────────────
    async function loadFixtures(val) {
        const sel = document.getElementById('sl-fixture');
        const hint = document.getElementById('sl-fixture-hint');
        try {
            const [{ fixtures }, { sessions }] = await Promise.all([
                fetch(basePath + '/api/developer/fixtures').then(r => r.json()),
                fetch(basePath + '/api/developer/sessions').then(r => r.json()).catch(() => ({ sessions: [] })),
            ]);

            loadedSessions = sessions;

            // Auto-select: prefer URL param, then first session, then nothing
            let autoVal = val;
            let autoTheme = null;
            if (!autoVal && sessions.length > 0) {
                autoVal = 'session:' + sessions[0].sessionId;
                autoTheme = sessions[0].theme || null;
            }

            let html = '<option value="">— select —</option>';
            if (sessions.length > 0) {
                html += '<optgroup label="' + T.open_project + '">';
                html += sessions.map(s => {
                    const v = 'session:' + s.sessionId;
                    const name = s.fileName.replace(/\.elpx?$/, '');
                    return `<option value="${v}"${v === autoVal ? ' selected' : ''}>▶ ${name}</option>`;
                }).join('');
                html += '</optgroup>';
                hint.style.display = 'none';
            }
            if (fixtures.length > 0) {
                html += '<optgroup label="' + T.fixtures + '">';
                html += fixtures.map(f => `<option value="${f}"${f === autoVal ? ' selected' : ''}>${f}</option>`).join('');
                html += '</optgroup>';
            }
            sel.innerHTML = html;
            return { fixture: autoVal, theme: autoTheme };
        } catch { sel.innerHTML = '<option value="">' + T.error_loading + '</option>'; return { fixture: val, theme: null }; }
    }

    async function loadThemes(val) {
        const sel = document.getElementById('sl-theme');
        try {
            const { themes } = await fetch(basePath + '/api/themes/installed').then(r => r.json());
            loadedThemes = themes;
            sel.innerHTML = '<option value="">' + T.select_theme + '</option>' +
                themes.map(t => {
                    const sel2 = val ? t.dirName === val : t.isDefault;
                    return `<option value="${t.dirName}"${sel2 ? ' selected' : ''}>${t.displayName}</option>`;
                }).join('');
            // Fall back to first theme if nothing was selected
            if (!sel.value && themes.length > 0) sel.value = themes[0].dirName;
        } catch { sel.innerHTML = '<option value="">' + T.error_loading + '</option>'; }
        updateDeleteThemeBtn();
    }

    function updateDeleteThemeBtn() {
        const dirName = document.getElementById('sl-theme').value;
        const theme = loadedThemes.find(t => t.dirName === dirName);
        const btn = document.getElementById('btn-files-delete-theme');
        btn.style.display = (theme && theme.type === 'site') ? '' : 'none';
    }

    async function loadThemeFiles(themeDirName, isReload = false) {
        const theme = loadedThemes.find(t => t.dirName === themeDirName);
        if (!theme?.url) return;
        themeFiles = {};
        const cacheToken = encodeURIComponent(String(themeReloadToken));
        const withCacheToken = url => url + (url.includes('?') ? '&' : '?') + 'slReload=' + cacheToken;
        const toFetch = [
            ...(theme.cssFiles || ['style.css']).map(f => ({ path: f, url: withCacheToken(theme.url + '/' + f) })),
            ...(theme.js     || ['style.js' ]).map(f => ({ path: f, url: withCacheToken(theme.url + '/' + f) })),
        ];
        await Promise.allSettled(toFetch.map(async ({ path, url }) => {
            try {
                const r = await fetch(url);
                if (r.ok) themeFiles[path] = await r.text();
            } catch {}
        }));
        renderFileList();
        const firstCss = toFetch.find(f => f.path.endsWith('.css'));
        if (firstCss && themeFiles[firstCss.path] != null) setEditorFile(firstCss.path, isReload);
    }

    function setEditorFile(path, forceReset = false) {
        const newOriginal = themeFiles[path] || '';
        const ta = document.getElementById('sl-css-textarea');
        const isAlreadyActive = path === activeCssFile;
        const isModified = document.getElementById('sl-modified-dot').classList.contains('on');

        activeCssFile = path;
        originalCss = newOriginal;
        document.getElementById('sl-editor-file-label').textContent = path;

        // Preserve user edits when the same file reloads (e.g. export type switch)
        if (isAlreadyActive && isModified && !forceReset) return;

        ta.value = originalCss;
        markModified(false);
        updateHighlight();
    }

    function renderFileList() {
        const list = document.getElementById('sl-file-list');
        const paths = Object.keys(themeFiles);
        if (!paths.length) { list.innerHTML = '<li class="sl-file-empty">No editable files found.</li>'; return; }
        list.innerHTML = paths.map(p => {
            const ext = p.split('.').pop();
            return `<li class="sl-file-item${p === activeCssFile ? ' active' : ''}" data-file="${p}">${p}<span class="sl-file-ext">${ext}</span></li>`;
        }).join('');
        list.querySelectorAll('.sl-file-item').forEach(li => {
            li.addEventListener('click', () => {
                list.querySelectorAll('.sl-file-item').forEach(x => x.classList.remove('active'));
                li.classList.add('active');
                setEditorFile(li.dataset.file);
                switchTab('css');
            });
        });
    }

    // ─── CSS injection ────────────────────────────────────────
    function injectStyle(id, css) {
        const iframe = document.getElementById('sl-iframe');
        if (!iframe.contentDocument) return;
        try {
            const doc = iframe.contentDocument;
            let el = doc.getElementById(id);
            if (!el) { el = doc.createElement('style'); el.id = id; doc.head.appendChild(el); }
            el.textContent = css;
        } catch(e) { console.warn('[Style Lab] inject:', e); }
    }

    // CSS from the textarea comes from theme/style.css, so url() paths are relative to theme/.
    // When injected as an inline <style> they must be relative to the document root, not theme/.
    function rebaseThemeUrls(css) {
        return css.replace(/url\(\s*(['"]?)(?!https?:|data:|\/|#)([^)'"]+)\1\s*\)/gi,
            (_, q, p) => `url(${q}theme/${p}${q})`);
    }
    function injectEditorCss(css) { injectStyle('sl-editor-css', rebaseThemeUrls(css)); }
    function injectQuickCss(css)  { injectStyle('sl-quick-css', css); }
    function injectClickCss(css)  { injectStyle('sl-click-css', css); }

    // ─── Sync Quick inputs from real theme colours ────────────
    function syncQuickFromTheme() {
        const doc = document.getElementById('sl-iframe').contentDocument;
        if (!doc?.body) return;

        function toHex(v) {
            if (!v || v === 'transparent') return null;
            const m = v.match(/[\d.]+/g);
            if (!m || m.length < 3) return null;
            // fully transparent → skip
            if (m.length >= 4 && parseFloat(m[3]) === 0) return null;
            return '#' + m.slice(0, 3).map(x => parseInt(x).toString(16).padStart(2, '0')).join('');
        }

        function gs(sel, prop) {
            try {
                // querySelector supports comma lists only partially; try first match
                const el = doc.querySelector(sel);
                return el ? getComputedStyle(el)[prop] : null;
            } catch { return null; }
        }

        const updates = {
            linkColor:           toHex(gs('a', 'color')),
            titleColor:          toHex(gs('.page-title', 'color')),
            textColor:           toHex(gs('body', 'color')),
            contentBgColor:      toHex(gs('.exe-content', 'backgroundColor')),
            pageBgColor:         toHex(gs('body', 'backgroundColor')),
            menuBgColor:         toHex(gs('#siteNav', 'backgroundColor')),
            menuTextColor:       toHex(gs('#siteNav a', 'color')),
            menuActiveBgColor:   toHex(gs('#siteNav a.active', 'backgroundColor'))
                              || toHex(gs('#siteNav li.active > a', 'backgroundColor')),
            menuActiveTextColor: toHex(gs('#siteNav a.active', 'color'))
                              || toHex(gs('#siteNav li.active > a', 'color')),
            packageTitleColor:   toHex(gs('.package-title', 'color')),
            boxBgColor:          toHex(gs('.iDevice', 'backgroundColor')),
            boxBorderColor:      toHex(gs('.iDevice', 'borderTopColor')),
            boxTitleColor:       toHex(gs('.iDevice_header', 'color') || gs('.box-head', 'color')),
            buttonBgColor:       toHex(gs('.feedbackbutton, .exe-quiz-btn', 'backgroundColor')
                                     || gs('.feedbackbutton', 'backgroundColor')),
            buttonTextColor:     toHex(gs('.feedbackbutton', 'color')),
        };

        // Font/size values
        const bodyFs = parseFloat(gs('body', 'fontSize'));
        if (bodyFs) updates.baseFontSize = Math.round(bodyFs);
        const bodyLh = parseFloat(gs('body', 'lineHeight'));
        if (bodyLh && bodyFs) updates.lineHeight = Math.round((bodyLh / bodyFs) * 10) / 10;
        const fontBody = gs('body', 'fontFamily');
        if (fontBody) updates.fontBody = fontBody.split(',')[0].trim().replace(/['"]/g, '');
        const titleEl = doc.querySelector('h1, h2, .page-title');
        if (titleEl) {
            const ff = getComputedStyle(titleEl).fontFamily;
            if (ff) updates.fontTitles = ff.split(',')[0].trim().replace(/['"]/g, '');
        }

        // Apply to inputs (skip keys already explicitly set by user)
        for (const [key, value] of Object.entries(updates)) {
            if (value === null || value === undefined) continue;
            if (key in quickState) continue; // user already changed this, don't overwrite
            const input = document.querySelector(`[data-quick="${key}"]`);
            if (input) input.value = value;
        }
    }

    function markModified(on) {
        document.getElementById('sl-modified-dot').classList.toggle('on', on);
    }

    // ─── Quick CSS builder (eXeLearning selectors) ────────────
    function collectQuick() {
        const q = {};
        document.querySelectorAll('[data-quick]').forEach(el => {
            const k = el.dataset.quick;
            if (el.type === 'checkbox') q[k] = el.checked;
            else if (el.type === 'number') q[k] = parseFloat(el.value) || 0;
            else q[k] = el.value;
        });
        return q;
    }

    function buildQuickCss(q) {
        const bang = ' !important';
        let css = '';
        if (q.linkColor) css += `a { color: ${q.linkColor}${bang}; }\n`;
        if (q.titleColor) css += `.page-title, .exe-content h1, .exe-content h2 { color: ${q.titleColor}${bang}; }\n`;
        if (q.textColor) css += `body, .exe-content p, .exe-content li { color: ${q.textColor}${bang}; }\n`;
        if (q.contentBgColor) css += `.exe-content, .page-content { background-color: ${q.contentBgColor}${bang}; }\n`;
        if (q.pageBgColor) css += `body { background-color: ${q.pageBgColor}${bang}; }\n`;
        if (q.contentOuterBgColor) css += `.exe-web-site, .exe-scorm { background-color: ${q.contentOuterBgColor}${bang}; }\n`;
        if (q.fontBody) css += `body, p, li, td { font-family: ${q.fontBody}${bang}; }\n`;
        if (q.fontTitles) css += `h1, h2, h3, h4, .page-title { font-family: ${q.fontTitles}${bang}; }\n`;
        if (q.baseFontSize) css += `body { font-size: ${q.baseFontSize}px${bang}; }\n`;
        if (q.lineHeight) css += `body { line-height: ${q.lineHeight}${bang}; }\n`;
        if (q.pageTitleSize) css += `.page-title { font-size: ${q.pageTitleSize}rem${bang}; }\n`;
        if (q.pageTitleWeight) css += `.page-title { font-weight: ${q.pageTitleWeight}${bang}; }\n`;
        if (q.pageTitleUppercase) css += `.page-title { text-transform: uppercase${bang}; }\n`;
        if (q.packageTitleColor) css += `.package-title { color: ${q.packageTitleColor}${bang}; }\n`;
        if (q.menuBgColor) css += `#siteNav, .site-nav { background-color: ${q.menuBgColor}${bang}; }\n`;
        if (q.menuTextColor) css += `#siteNav a, .site-nav a { color: ${q.menuTextColor}${bang}; }\n`;
        if (q.menuHoverBgColor) css += `#siteNav a:hover, .site-nav a:hover { background-color: ${q.menuHoverBgColor}${bang}; }\n`;
        if (q.menuHoverTextColor) css += `#siteNav a:hover, .site-nav a:hover { color: ${q.menuHoverTextColor}${bang}; }\n`;
        if (q.menuActiveBgColor) css += `#siteNav a.active, #siteNav li.active > a, #siteNav .active > a, .site-nav a.active, .site-nav li.active > a { background-color: ${q.menuActiveBgColor}${bang}; }\n`;
        if (q.menuActiveTextColor) css += `#siteNav a.active, #siteNav li.active > a, #siteNav .active > a, .site-nav a.active, .site-nav li.active > a { color: ${q.menuActiveTextColor}${bang}; }\n`;
        if (q.boxBgColor) css += `.iDevice, .box { background-color: ${q.boxBgColor}${bang}; }\n`;
        if (q.boxBorderColor) css += `.iDevice, .box { border-color: ${q.boxBorderColor}${bang}; }\n`;
        if (q.boxTitleColor) css += `.iDevice_header, .box-head { color: ${q.boxTitleColor}${bang}; }\n`;
        if (q.buttonBgColor) css += `.feedbackbutton, .exe-quiz-btn, button.btn { background-color: ${q.buttonBgColor}${bang}; }\n`;
        if (q.buttonTextColor) css += `.feedbackbutton, .exe-quiz-btn, button.btn { color: ${q.buttonTextColor}${bang}; }\n`;
        return css;
    }

    document.querySelectorAll('[data-quick]').forEach(el => {
        el.addEventListener('input', () => {
            if (!previewReady) return;
            pushUndo();
            // Only update the changed key — avoids overriding theme values for untouched controls
            const k = el.dataset.quick;
            const v = el.type === 'checkbox' ? el.checked : el.type === 'number' ? (parseFloat(el.value) || 0) : el.value;
            quickState = { ...quickState, [k]: v };
            injectQuickCss(buildScopeWrapped(buildQuickCss(quickState)));
        });
    });

    // ─── Editor actions ───────────────────────────────────────
    document.getElementById('btn-apply-css').addEventListener('click', () => {
        if (!previewReady) return;
        injectEditorCss(document.getElementById('sl-css-textarea').value);
        setStatus(T.css_applied);
    });

    document.getElementById('btn-reset-css').addEventListener('click', () => {
        document.getElementById('sl-css-textarea').value = originalCss;
        markModified(false);
        updateHighlight();
        if (previewReady) injectEditorCss(originalCss);
        setStatus(T.css_reset);
    });

    document.getElementById('btn-wrap-scope').addEventListener('click', () => {
        const classes = getScopeClasses();
        if (classes.length === 0 || classes.length === SCOPE_ALL.length) {
            setStatus(T.scope_all);
            return;
        }
        const ta = document.getElementById('sl-css-textarea');
        const start = ta.selectionStart, end = ta.selectionEnd;
        const selected = ta.value.substring(start, end).trim();
        if (!selected) { setStatus(T.select_css_first); return; }
        const wrapped = buildScopeWrapped(selected);
        ta.setRangeText(wrapped, start, end, 'select');
        markModified(true);
        updateHighlight();
        if (previewReady) injectEditorCss(ta.value);
        setStatus(T.wrapped);
    });

    // ─── Click-to-edit (inspect mode) ────────────────────────
    function injectInspector() {
        const iframe = document.getElementById('sl-iframe');
        try {
            const doc = iframe.contentDocument;
            if (!doc) return;
            const prev = doc.getElementById('__sl_insp');
            if (prev) prev.remove();
            const s = doc.createElement('script');
            s.id = '__sl_insp';
            s.textContent = `(function(){
  window.__slInspect=false;
  var hl=null;
  function sel(el){
    if(el.id) return '#'+CSS.escape(el.id);
    var s=el.tagName.toLowerCase();
    if(el.className&&typeof el.className==='string')
      el.className.trim().split(/\\s+/).forEach(function(c){if(c)s+='.'+CSS.escape(c);});
    return s;
  }
  document.addEventListener('click',function(e){
    if(!window.__slInspect)return;
    e.preventDefault();e.stopPropagation();
    var cs=window.getComputedStyle(e.target);
    window.parent.postMessage({type:'SL_CLICK',selector:sel(e.target),
      textColor:cs.color,bgColor:cs.backgroundColor,
      fontSize:parseFloat(cs.fontSize)||16,fontWeight:cs.fontWeight},'\*');
  },true);
  document.addEventListener('mouseover',function(e){if(!window.__slInspect)return;e.target.style.outline='2px solid #0ba1a1';},true);
  document.addEventListener('mouseout',function(e){if(!window.__slInspect)return;e.target.style.outline='';},true);
})();`;
            doc.head.appendChild(s);
        } catch(e) { console.warn('[Style Lab] inspector:', e); }
    }

    function rgbToHex(rgb) {
        if (!rgb || rgb === 'transparent') return null;
        const m = rgb.match(/[\d.]+/g);
        if (!m || m.length < 3) return null;
        // fully transparent (alpha = 0) → treat as no color
        if (m.length >= 4 && parseFloat(m[3]) === 0) return null;
        return '#' + m.slice(0,3).map(x => parseInt(x).toString(16).padStart(2,'0')).join('');
    }

    // ─── Click-edit live preview helpers ─────────────────────
    function buildClickRule() {
        const s = clickEditSelector;
        if (!s) return '';
        const textColor  = document.getElementById('ce-textColor').value;
        const bgInput    = document.getElementById('ce-bgColor');
        const bgColor    = bgInput.dataset.skip ? null : bgInput.value;
        const fontSize   = document.getElementById('ce-fontSize').value;
        const fontWeight = document.getElementById('ce-fontWeight').value;
        const textAlign  = document.getElementById('ce-textAlign').value;
        let rule = `${s} {\n`;
        if (textColor)  rule += `  color: ${textColor} !important;\n`;
        if (bgColor)    rule += `  background-color: ${bgColor} !important;\n`;
        if (fontSize)   rule += `  font-size: ${fontSize}px !important;\n`;
        if (fontWeight) rule += `  font-weight: ${fontWeight} !important;\n`;
        if (textAlign)  rule += `  text-align: ${textAlign} !important;\n`;
        rule += `}`;
        return rule;
    }

    function injectClickPreview() {
        if (previewReady) injectStyle('sl-click-preview', buildScopeWrapped(buildClickRule()));
    }

    function clearClickPreview() {
        injectStyle('sl-click-preview', '');
    }

    // Live preview on any modal input change
    document.getElementById('ce-bgColor').addEventListener('input', function() {
        delete this.dataset.skip;
        injectClickPreview();
    });
    ['ce-textColor', 'ce-fontSize', 'ce-fontWeight', 'ce-textAlign'].forEach(id => {
        document.getElementById(id).addEventListener('input', injectClickPreview);
        document.getElementById(id).addEventListener('change', injectClickPreview);
    });

    window.addEventListener('message', e => {
        if (e.data?.type !== 'SL_CLICK') return;
        const { selector, textColor, bgColor, fontSize, fontWeight } = e.data;
        clickEditSelector = selector;
        document.getElementById('sl-click-modal-selector').textContent = selector;
        const textHex = rgbToHex(textColor);
        const bgHex   = rgbToHex(bgColor);
        document.getElementById('ce-textColor').value = textHex || '#333333';
        const bgInput = document.getElementById('ce-bgColor');
        bgInput.value = bgHex || '#ffffff';
        bgInput.dataset.skip = bgHex ? '' : '1';
        document.getElementById('ce-fontSize').value = Math.round(fontSize) || 16;
        document.getElementById('ce-fontWeight').value = ['400','600','700','800'].includes(fontWeight) ? fontWeight : '';
        document.getElementById('ce-textAlign').value = '';
        document.getElementById('sl-click-modal').classList.add('open');
        setInspect(false);
    });

    document.getElementById('btn-click-apply').addEventListener('click', () => {
        pushUndo();
        clearClickPreview();
        const rule = buildClickRule();
        const ta = document.getElementById('sl-css-textarea');
        ta.value = appendToControlledBlock(ta.value, CLICK_BLOCK_START, CLICK_BLOCK_END, buildScopeWrapped(rule));
        markModified(true);
        updateHighlight();
        injectEditorCss(ta.value);
        document.getElementById('sl-click-modal').classList.remove('open');
        setStatus(T.rule_added);
    });

    document.getElementById('btn-click-cancel').addEventListener('click', () => {
        clearClickPreview();
        document.getElementById('sl-click-modal').classList.remove('open');
    });
    document.getElementById('sl-click-modal-close').addEventListener('click', () => {
        clearClickPreview();
        document.getElementById('sl-click-modal').classList.remove('open');
    });

    // Draggable modal
    (function() {
        const modal = document.getElementById('sl-click-modal');
        const header = document.getElementById('sl-click-modal-header');
        let ox, oy, drag = false;
        header.addEventListener('mousedown', e => {
            drag = true;
            const r = modal.getBoundingClientRect();
            ox = e.clientX - r.left; oy = e.clientY - r.top;
            modal.style.right = 'auto';
        });
        document.addEventListener('mousemove', e => {
            if (!drag) return;
            modal.style.left = (e.clientX - ox) + 'px';
            modal.style.top  = (e.clientY - oy) + 'px';
        });
        document.addEventListener('mouseup', () => { drag = false; });
    })();

    function setInspect(on) {
        inspectMode = on;
        document.getElementById('btn-inspect').classList.toggle('active', on);
        document.body.classList.toggle('sl-inspect', on);
        const iw = document.getElementById('sl-iframe');
        try { iw.contentWindow.__slInspect = on; } catch {}
        setStatus(on ? T.inspect_hint : T.ready);
    }

    document.getElementById('btn-inspect').addEventListener('click', () => {
        if (!previewReady) { setStatus(T.load_preview_first); return; }
        setInspect(!inspectMode);
    });

    // ─── Print simulation ─────────────────────────────────────
    function applyPrintSim() {
        const iframe = document.getElementById('sl-iframe');
        const doc = iframe.contentDocument;
        if (!doc) return;
        doc.getElementById('sl-print-sim')?.remove();
        if (selectedExport !== 'html5-sp') return;
        const parts = [];
        for (const sheet of doc.styleSheets) {
            try {
                for (const rule of sheet.cssRules) {
                    if (rule instanceof CSSMediaRule) {
                        const media = rule.conditionText || rule.media?.mediaText || '';
                        if (/\bprint\b/.test(media)) {
                            const inner = [...rule.cssRules].map(r => r.cssText).join('\n  ');
                            parts.push(`@media screen {\n  ${inner}\n}`);
                        }
                    }
                }
            } catch { /* cross-origin sheet — skip */ }
        }
        if (!parts.length) return;
        const style = doc.createElement('style');
        style.id = 'sl-print-sim';
        style.textContent = parts.join('\n\n');
        doc.head.appendChild(style);
    }

    function updatePrintSimVisibility() {
        applyPrintSim();
    }

    // ─── Theme export / install ───────────────────────────────
    function buildFileOverrides() {
        const overrides = {};
        if (activeCssFile) {
            let css = document.getElementById('sl-css-textarea').value;
            const quickCss = buildScopeWrapped(buildQuickCss(quickState));
            css = replaceControlledBlock(css, QUICK_BLOCK_START, QUICK_BLOCK_END, quickCss);
            overrides[activeCssFile] = css;
        }
        return overrides;
    }

    function collectThemeMetadata() {
        return {
            name: document.getElementById('sl-files-dir-name').value.trim(),
            title: document.getElementById('sl-files-display-name').value.trim(),
            version: document.getElementById('sl-files-meta-version').value.trim(),
            compatibility: document.getElementById('sl-files-meta-compatibility').value.trim(),
            author: document.getElementById('sl-files-meta-author').value.trim(),
            license: document.getElementById('sl-files-meta-license').value.trim(),
            licenseUrl: document.getElementById('sl-files-meta-license-url').value.trim(),
            description: document.getElementById('sl-files-meta-description').value.trim(),
            downloadable: document.getElementById('sl-files-meta-downloadable').value,
        };
    }

    function setThemeMetadataControls(theme) {
        const metadata = loadedThemes.find(t => t.dirName === theme) || {};
        document.getElementById('sl-files-meta-version').value = metadata.version || '1.0';
        document.getElementById('sl-files-meta-compatibility').value = metadata.compatibility || '3.0';
        document.getElementById('sl-files-meta-author').value = metadata.author || '';
        document.getElementById('sl-files-meta-license').value = metadata.license || '';
        document.getElementById('sl-files-meta-license-url').value = metadata.licenseUrl || metadata.licenseURL || '';
        document.getElementById('sl-files-meta-description').value = metadata.description || '';
        document.getElementById('sl-files-meta-downloadable').value = String(metadata.downloadable ?? '1') === '0' ? '0' : '1';
    }

    function isBaseTheme(dirName) {
        const t = loadedThemes.find(t => t.dirName === dirName);
        return t ? t.type === 'base' : false;
    }

    function slugify(str) {
        return str.toLowerCase()
            .replace(/[áàäâ]/g, 'a').replace(/[éèëê]/g, 'e')
            .replace(/[íìïî]/g, 'i').replace(/[óòöô]/g, 'o')
            .replace(/[úùüû]/g, 'u').replace(/ñ/g, 'n')
            .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    }

    function openFilesTab(theme) {
        const warning = document.getElementById('sl-files-warning');
        const errEl = document.getElementById('sl-files-error');
        const displayEl = document.getElementById('sl-files-display-name');
        const dirEl = document.getElementById('sl-files-dir-name');
        const installBtn = document.getElementById('btn-files-install');

        warning.style.display = isBaseTheme(theme) ? '' : 'none';
        errEl.style.display = 'none';

        // Only prefill if empty or switching to a different source theme
        if (!displayEl.value || displayEl.dataset.srcTheme !== theme) {
            displayEl.value = theme + '-custom';
            dirEl.value = slugify(theme + '-custom');
            displayEl.dataset.srcTheme = theme;
        }
        setThemeMetadataControls(theme);

        const fixtureVal = document.getElementById('sl-fixture').value;
        const hasSession = fixtureVal.startsWith('session:');
        installBtn.disabled = !hasSession;
        installBtn.title = hasSession ? T.install_apply_title : T.no_session_title;

        setActiveTab('files');
        displayEl.focus();
        displayEl.select();
    }

    // Auto-generate dirName from displayName
    document.getElementById('sl-files-display-name').addEventListener('input', e => {
        document.getElementById('sl-files-dir-name').value = slugify(e.target.value);
    });

    document.getElementById('btn-goto-files').addEventListener('click', () => {
        const theme = document.getElementById('sl-theme').value;
        if (!theme) { setStatus(T.select_theme_first); return; }
        openFilesTab(theme);
    });

    async function captureScreenshot() {
        const iframe = document.getElementById('sl-iframe');
        if (!iframe || !iframe.contentDocument?.body) return null;
        if (typeof html2canvas === 'undefined') return null;
        try {
            const iw = iframe.contentWindow;
            const canvas = await html2canvas(iframe.contentDocument.body, {
                allowTaint: true, useCORS: true, scale: 1,
                width: iw.innerWidth || 1200, height: iw.innerHeight || 550,
                windowWidth: iw.innerWidth || 1200, windowHeight: iw.innerHeight || 550,
                x: 0, y: 0, scrollX: 0, scrollY: 0,
            });
            const out = document.createElement('canvas');
            out.width = 1200; out.height = 550;
            out.getContext('2d').drawImage(canvas, 0, 0, 1200, 550);
            return out.toDataURL('image/png').split(',')[1];
        } catch(e) {
            console.warn('[Style Lab] Screenshot failed:', e);
            return null;
        }
    }

    async function doExportOrInstall(install) {
        const theme = document.getElementById('sl-theme').value;
        const newDisplayName = document.getElementById('sl-files-display-name').value.trim();
        const newDirName = document.getElementById('sl-files-dir-name').value.trim();
        const errEl = document.getElementById('sl-files-error');
        errEl.style.display = 'none';

        if (!newDisplayName || !newDirName) {
            errEl.textContent = T.fill_name_id;
            errEl.style.display = '';
            return;
        }
        if (!/^[a-z0-9_-]+$/.test(newDirName)) {
            errEl.textContent = T.id_invalid;
            errEl.style.display = '';
            return;
        }

        const dlBtn = document.getElementById('btn-files-download');
        const instBtn = document.getElementById('btn-files-install');
        dlBtn.disabled = true; instBtn.disabled = true;

        try {
            const fileOverrides = buildFileOverrides();
            const themeMetadata = collectThemeMetadata();

            setStatus(T.capturing);
            const screenshotBase64 = previewReady ? await captureScreenshot() : null;

            if (install) {
                const fixtureVal = document.getElementById('sl-fixture').value;
                const sessionId = fixtureVal.startsWith('session:') ? fixtureVal.slice(8) : null;
                setStatus(T.installing);
                const res = await fetch(basePath + '/api/developer/style-lab/install-theme', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ theme, fileOverrides, themeMetadata, newDirName, newDisplayName, sessionId, screenshotBase64 }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    errEl.textContent = data.error || res.statusText;
                    errEl.style.display = '';
                    return;
                }
                if (sessionId && data.themeApplied) {
                    setStatus(T.theme_applied);
                    setTimeout(() => { window.location.href = basePath + '/workarea?project=' + sessionId + '&apply_theme=' + encodeURIComponent(data.dirName); }, 1500);
                } else if (sessionId) {
                    setStatus(T.theme_no_apply);
                } else {
                    setStatus(T.theme_installed + newDisplayName);
                    await loadThemes(newDirName);
                }
            } else {
                setStatus(T.exporting);
                const res = await fetch(basePath + '/api/developer/style-lab/export-theme', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ theme, fileOverrides, themeMetadata, screenshotBase64 }),
                });
                if (!res.ok) {
                    const data = await res.json().catch(() => ({}));
                    errEl.textContent = data.message || res.statusText;
                    errEl.style.display = '';
                    return;
                }
                const blob = await res.blob();
                const a = Object.assign(document.createElement('a'), {
                    href: URL.createObjectURL(blob),
                    download: newDirName + '.zip',
                });
                a.click(); URL.revokeObjectURL(a.href);
                setStatus(T.downloaded + newDirName + '.zip');
            }
        } catch(e) {
            errEl.textContent = 'Error: ' + e.message;
            errEl.style.display = '';
        } finally {
            dlBtn.disabled = false;
            const fixtureVal = document.getElementById('sl-fixture').value;
            instBtn.disabled = !fixtureVal.startsWith('session:');
        }
    }

    document.getElementById('btn-files-download').addEventListener('click', () => doExportOrInstall(false));
    document.getElementById('btn-files-install').addEventListener('click', () => doExportOrInstall(true));

    // ─── Tabs ─────────────────────────────────────────────────
    function setActiveTab(name) {
        document.querySelectorAll('.sl-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
        document.querySelectorAll('.sl-tab-panel').forEach(p => p.classList.toggle('active', p.dataset.panel === name));
    }

    function switchTab(name) {
        setActiveTab(name);
        if (name === 'files') {
            const theme = document.getElementById('sl-theme').value;
            if (theme) openFilesTab(theme);
        }
    }
    document.querySelectorAll('.sl-tab').forEach(t => t.addEventListener('click', () => switchTab(t.dataset.tab)));

    // ─── Upload theme ZIP ─────────────────────────────────────
    let uploadedZipBytes = null;

    function parseXmlField(xml, tag) {
        const m = xml.match(new RegExp('<' + tag + '>([^<]*)</' + tag + '>'));
        return m ? m[1].trim() : '';
    }

    function populateFromZipConfig(configXml) {
        const get = tag => parseXmlField(configXml, tag);
        const displayName = get('title') || get('name') || '';
        const dirName = get('name') ? slugify(get('name')) : '';
        if (displayName) document.getElementById('sl-files-display-name').value = displayName;
        if (dirName) document.getElementById('sl-files-dir-name').value = dirName + (dirName ? '-upload' : '');
        document.getElementById('sl-files-meta-version').value = get('version') || '1.0';
        document.getElementById('sl-files-meta-compatibility').value = get('compatibility') || '3.0';
        document.getElementById('sl-files-meta-author').value = get('author') || '';
        document.getElementById('sl-files-meta-license').value = get('license') || '';
        document.getElementById('sl-files-meta-license-url').value = get('license-url') || '';
        document.getElementById('sl-files-meta-description').value = get('description') || '';
        const dl = get('downloadable');
        document.getElementById('sl-files-meta-downloadable').value = dl === '0' ? '0' : '1';
    }

    document.getElementById('btn-files-upload-pick').addEventListener('click', () => {
        document.getElementById('sl-files-zip-input').click();
    });

    document.getElementById('sl-files-zip-input').addEventListener('change', async e => {
        const file = e.target.files[0];
        e.target.value = '';
        if (!file) return;
        document.getElementById('sl-files-upload-name').textContent = T.reading_zip;
        document.getElementById('btn-files-upload-install').disabled = true;
        try {
            const buf = await file.arrayBuffer();
            uploadedZipBytes = new Uint8Array(buf);
            const zip = window.fflate.unzipSync(uploadedZipBytes);
            // Find config.xml (possibly under a root folder)
            const configEntry = Object.entries(zip).find(([n]) => /(?:^|\/)config\.xml$/.test(n));
            if (configEntry) {
                const xmlText = new TextDecoder().decode(configEntry[1]);
                populateFromZipConfig(xmlText);
                // Warn: uploaded theme, no base-theme restriction
                document.getElementById('sl-files-warning').style.display = 'none';
            }
            document.getElementById('sl-files-upload-name').textContent = file.name;
            document.getElementById('btn-files-upload-install').disabled = false;
            document.getElementById('sl-files-error').style.display = 'none';
        } catch(err) {
            uploadedZipBytes = null;
            document.getElementById('sl-files-upload-name').textContent = T.no_file_selected;
            document.getElementById('sl-files-error').textContent = 'Error reading ZIP: ' + err.message;
            document.getElementById('sl-files-error').style.display = '';
        }
    });

    document.getElementById('btn-files-upload-install').addEventListener('click', async () => {
        if (!uploadedZipBytes) return;
        const newDisplayName = document.getElementById('sl-files-display-name').value.trim();
        const newDirName = document.getElementById('sl-files-dir-name').value.trim();
        const errEl = document.getElementById('sl-files-error');
        errEl.style.display = 'none';

        if (!newDisplayName || !newDirName) { errEl.textContent = T.fill_name_id; errEl.style.display = ''; return; }
        if (!/^[a-z0-9_-]+$/.test(newDirName)) { errEl.textContent = T.id_invalid; errEl.style.display = ''; return; }

        const btn = document.getElementById('btn-files-upload-install');
        btn.disabled = true;
        setStatus(T.uploading_theme);
        try {
            // Convert to base64
            let binary = '';
            for (let i = 0; i < uploadedZipBytes.length; i++) binary += String.fromCharCode(uploadedZipBytes[i]);
            const zipBase64 = btoa(binary);
            const themeMetadata = collectThemeMetadata();
            const res = await fetch(basePath + '/api/developer/style-lab/upload-theme', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ zipBase64, newDirName, newDisplayName, themeMetadata }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
                errEl.textContent = data.error || res.statusText;
                errEl.style.display = '';
                return;
            }
            setStatus(T.theme_uploaded + newDisplayName);
            uploadedZipBytes = null;
            document.getElementById('sl-files-upload-name').textContent = T.no_file_selected;
            await loadThemes(newDirName);
            // Switch to the newly installed theme for preview
            if (document.getElementById('sl-fixture').value) runPreview();
        } catch(err) {
            errEl.textContent = 'Error: ' + err.message;
            errEl.style.display = '';
        } finally {
            btn.disabled = !uploadedZipBytes;
        }
    });

    // ─── Viewport + export type ───────────────────────────────
    document.querySelectorAll('[data-viewport]').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('[data-viewport]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('sl-iframe-wrap').className = 'vp-' + btn.dataset.viewport;
            pushParams({ viewport: btn.dataset.viewport });
        });
    });
    document.querySelectorAll('[data-export]').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('[data-export]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            selectedExport = btn.dataset.export;
            pushParams({ export: selectedExport });
            updatePrintSimVisibility();
            if (previewReady) runPreview();
        });
    });
    document.getElementById('sl-fixture').addEventListener('change', async e => {
        pushParams({ fixture: e.target.value || null });
        updateActions();
        // If the selected fixture is a session with a known theme, auto-select it
        if (e.target.value && e.target.value.startsWith('session:')) {
            const sessionId = e.target.value.replace('session:', '');
            const session = loadedSessions.find(s => s.sessionId === sessionId);
            if (session?.theme && !document.getElementById('sl-theme').value) {
                await loadThemes(session.theme);
            }
        }
        if (e.target.value && document.getElementById('sl-theme').value) runPreview();
    });
    document.getElementById('sl-theme').addEventListener('change', e => {
        pushParams({ theme: e.target.value || null });
        updateActions();
        updateDeleteThemeBtn();
        if (e.target.value && document.getElementById('sl-fixture').value) runPreview();
    });

    document.getElementById('btn-files-delete-theme').addEventListener('click', async () => {
        const dirName = document.getElementById('sl-theme').value;
        const theme = loadedThemes.find(t => t.dirName === dirName);
        if (!theme) return;
        if (!window.confirm(T.confirm_delete.replace('{name}', theme.displayName))) return;
        try {
            const res = await fetch(basePath + '/api/developer/themes/' + encodeURIComponent(dirName), { method: 'DELETE' });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) { setStatus(T.error_deleting + (data.error || res.statusText)); return; }
            setStatus(T.theme_deleted + theme.displayName);
            await loadThemes('');
        } catch(e) {
            setStatus(T.error_deleting_theme);
        }
    });
    document.querySelectorAll('[data-meta]').forEach(cb => {
        cb.addEventListener('change', () => {
            pushParams({ [cb.dataset.meta]: cb.checked ? '1' : '0' });
            if (previewReady) runPreview();
        });
    });

    function getEditorUrl() {
        const fixture = document.getElementById('sl-fixture').value;
        if (fixture && fixture.startsWith('session:')) {
            const sessionId = fixture.slice(8);
            return basePath + '/workarea?project=' + sessionId;
        }
        return basePath + '/workarea';
    }

    function updateActions() {
        document.getElementById('btn-files-open-window').disabled = !previewReady;
        const fixture = document.getElementById('sl-fixture').value;
        const hasSession = fixture && fixture.startsWith('session:');
        document.getElementById('btn-files-discard-back').disabled = !hasSession;
        document.getElementById('btn-files-install').disabled = !hasSession;
        document.getElementById('sl-back-link').href = getEditorUrl();
    }

    // ─── Preview ──────────────────────────────────────────────
    async function runPreview() {
        const fixtureVal = document.getElementById('sl-fixture').value;
        const theme      = document.getElementById('sl-theme').value;
        if (!fixtureVal || !theme) return;
        setStatus(T.generating);
        setLoading(true);
        try {
            await ensureServiceWorker();
            const url = new URL(basePath + '/api/developer/style-lab/preview', location.href);
            // fixtureVal is either "session:<id>" or a fixture filename
            if (fixtureVal.startsWith('session:')) {
                url.searchParams.set('session', fixtureVal.slice(8));
            } else {
                url.searchParams.set('fixture', fixtureVal);
            }
            url.searchParams.set('theme', theme);
            url.searchParams.set('exportType', selectedExport);
            document.querySelectorAll('[data-meta]').forEach(cb =>
                url.searchParams.set(cb.dataset.meta, cb.checked ? '1' : '0'));
            setStatus(T.fetching);
            const res = await fetch(url.toString());
            if (!res.ok) { const e = await res.json().catch(()=>({})); throw new Error(e.message || res.statusText); }
            setStatus(T.decompressing);
            const buf = await res.arrayBuffer();
            const zip = window.fflate.unzipSync(new Uint8Array(buf));
            const files = {};
            for (const [p, d] of Object.entries(zip)) files[p] = d.buffer.slice(d.byteOffset, d.byteOffset + d.byteLength);
            setStatus(T.sending_sw);
            const n = await sendToSW(files);
            previewReady = true;
            updateActions();
            showPreview();
            loadThemeFiles(theme).catch(() => {});
            setStatus(n + ' files · ' + fixtureVal + ' · ' + theme);
        } catch(e) {
            setStatus('Error: ' + e.message); // e.message is always technical/English
            console.error('[Style Lab]', e);
        } finally { setLoading(false); }
    }

    function showPreview() {
        const iframe = document.getElementById('sl-iframe');
        iframe.onload = () => {
            injectInspector();
            syncQuickFromTheme();   // read real theme colours BEFORE any injection
            const css = document.getElementById('sl-css-textarea').value;
            if (css) injectEditorCss(css);
            if (Object.keys(quickState).length) injectQuickCss(buildScopeWrapped(buildQuickCss(quickState)));
            applyPrintSim();
        };
        if (iframe.src && iframe.src.includes('/viewer/')) {
            iframe.src = 'about:blank';
            setTimeout(() => { iframe.src = viewerUrl; }, 50);
        } else {
            iframe.src = viewerUrl;
        }
        iframe.style.display = '';
        document.getElementById('sl-placeholder').style.display = 'none';
    }

    document.getElementById('btn-files-open-window').addEventListener('click', () => {
        if (previewReady) window.open(viewerUrl, '_blank');
    });
    document.getElementById('btn-files-reload-theme').addEventListener('click', async () => {
        try { await fetch(basePath + '/api/developer/reload-theme', { method: 'POST' }); } catch {}
        themeReloadToken = Date.now();
        const f = document.getElementById('sl-fixture').value;
        const t = document.getElementById('sl-theme').value;
        if (f && t) {
            await runPreview();
            await loadThemeFiles(t, true); // force reset textarea on explicit reload
        } else {
            setStatus(T.select_fixture_theme);
        }
    });

    function hasUnsavedChanges() {
        const cssModified = document.getElementById('sl-modified-dot').classList.contains('on');
        const quickModified = Object.keys(quickState).length > 0;
        return cssModified || quickModified;
    }

    document.getElementById('sl-back-link').addEventListener('click', e => {
        if (!hasUnsavedChanges()) return;
        e.preventDefault();
        const confirmed = window.confirm(T.confirm_unsaved);
        if (confirmed) window.location.href = e.currentTarget.href;
    });

    document.getElementById('btn-files-discard-back').addEventListener('click', () => {
        if (hasUnsavedChanges()) {
            const confirmed = window.confirm(T.confirm_discard);
            if (!confirmed) return;
        }
        window.location.href = getEditorUrl();
    });

    // ─── Helpers ──────────────────────────────────────────────
    function setStatus(msg) {
        document.getElementById('sl-status').textContent = msg;
        document.getElementById('sl-loading-label').textContent = msg;
    }
    function setLoading(on) {
        document.getElementById('sl-panel').classList.toggle('sl-loading', on);
        document.getElementById('sl-loading-overlay').classList.toggle('visible', on);
    }

    // ─── URL params ───────────────────────────────────────────
    function applyUrlParams() {
        const p = getParams();
        const exp = p.get('export');
        if (exp) { document.querySelectorAll('[data-export]').forEach(b => { const a = b.dataset.export === exp; b.classList.toggle('active', a); if (a) selectedExport = exp; }); }
        const vp = p.get('viewport');
        if (vp) { document.querySelectorAll('[data-viewport]').forEach(b => { const a = b.dataset.viewport === vp; b.classList.toggle('active', a); if (a) document.getElementById('sl-iframe-wrap').className = 'vp-' + vp; }); }
        document.querySelectorAll('[data-meta]').forEach(cb => { const v = p.get(cb.dataset.meta); if (v !== null) cb.checked = v === '1' || v === 'true'; });
        return { fixture: p.get('fixture'), theme: p.get('theme') };
    }

    // ─── Init ─────────────────────────────────────────────────
    async function init() {
        loadScope();
        const { fixture, theme } = applyUrlParams();
        const [fixtureResult] = await Promise.all([loadFixtures(fixture), loadThemes(theme)]);
        // If no theme in URL params but the loaded session has a known theme, apply it
        const effectiveFixture = fixtureResult.fixture;
        if (!theme && fixtureResult.theme) {
            await loadThemes(fixtureResult.theme);
        }
        updateActions();
        updatePrintSimVisibility();
        const effectiveTheme = document.getElementById('sl-theme').value;
        if (effectiveFixture && effectiveTheme) runPreview();
        if (navigator.serviceWorker) ensureServiceWorker().catch(() => {});
    }

    init();
})();
</script>
</body>
