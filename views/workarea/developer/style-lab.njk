<!DOCTYPE html>
<html lang="{{ locale or 'en' }}">
<head>
    <meta charset="UTF-8">
    <meta name="robots" content="noindex">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Style Lab — Developer</title>
    <link rel="icon" href="{{ '/favicon.ico' | asset }}">
    <link rel="stylesheet" href="{{ basePath }}/libs/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="{{ basePath }}/style/workarea/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>
    <style>
        :root {
            --bg: #eef1f4;
            --panel: #ffffff;
            --line: #d0d5dd;
            --line-soft: #eaecf0;
            --ink: #1f2937;
            --muted: #475467;
            --action: #0ba1a1;
            --action-dark: #107275;
            --header-h: 48px;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            font-size: 13px;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            background: var(--bg);
            color: var(--ink);
        }

        /* ── Header ─────────────────────────────────────────── */
        #sl-header {
            height: var(--header-h);
            background: #212529;
            color: #fff;
            display: flex;
            align-items: center;
            padding: 0 16px;
            gap: 10px;
            flex-shrink: 0;
        }
        #sl-header a { color: #adb5bd; text-decoration: none; font-size: 12px; }
        #sl-header a:hover { color: #fff; }
        #sl-header .sep { color: #495057; }
        #sl-header h1 { font-size: 14px; font-weight: 600; }
        #sl-badge {
            background: #198754; color: #fff;
            font-size: 10px; font-weight: 700;
            padding: 2px 7px; border-radius: 4px;
            letter-spacing: .5px; text-transform: uppercase;
        }

        /* ── Shell ───────────────────────────────────────────── */
        #sl-shell {
            display: grid;
            grid-template-columns: minmax(400px, 480px) 1fr;
            gap: 10px;
            padding: 10px;
            flex: 1;
            overflow: hidden;
        }

        /* ── Left panel ──────────────────────────────────────── */
        #sl-panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
        }

        /* Tabs */
        .sl-tabs {
            display: flex;
            border-bottom: 1px solid var(--line);
            background: #f8fafc;
            flex-shrink: 0;
        }
        .sl-tab {
            flex: 1;
            padding: 10px 4px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--muted);
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            transition: color .15s, border-color .15s;
        }
        .sl-tab.active { color: var(--action); border-bottom-color: var(--action); }
        .sl-tab:hover:not(.active) { color: var(--ink); }

        /* Tab panels */
        .sl-tab-panel { display: none; flex: 1; flex-direction: column; overflow: hidden; }
        .sl-tab-panel.active { display: flex; }

        /* Scrollable inner content */
        .sl-panel-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* ── Section headers ─────────────────────────────────── */
        .sl-section { display: flex; flex-direction: column; gap: 6px; }
        .sl-label {
            font-size: 10px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .6px;
            color: var(--muted);
        }
        .sl-section select, .sl-section input[type="text"], .sl-section input[type="number"] {
            width: 100%; padding: 6px 8px;
            border: 1px solid var(--line); border-radius: 6px;
            font-size: 12px; background: #fff; color: var(--ink);
        }
        .sl-section select:focus, .sl-section input:focus {
            outline: none; border-color: var(--action);
            box-shadow: 0 0 0 3px rgba(11,161,161,.12);
        }
        .sl-btn-group { display: flex; gap: 4px; }
        .sl-btn-group button {
            flex: 1; padding: 6px 4px;
            border: 1px solid var(--line); border-radius: 6px;
            background: #fff; font-size: 11px; cursor: pointer;
            transition: all .12s; color: var(--ink);
        }
        .sl-btn-group button.active,
        .sl-btn-group button:hover { background: var(--action); border-color: var(--action); color: #fff; }

        /* Export options */
        .sl-options-grid { display: flex; flex-direction: column; gap: 4px; }
        .sl-option {
            display: flex; align-items: center; gap: 8px;
            font-size: 12px; color: var(--muted); cursor: pointer; padding: 2px 0;
        }
        .sl-option input[type="checkbox"] { cursor: pointer; accent-color: var(--action); }

        /* CSS Scope */
        .sl-scope-chip {
            display: flex; align-items: center; gap: 4px;
            padding: 3px 10px; border-radius: 20px; font-size: 11px;
            border: 1px solid var(--line); background: #fff; color: var(--muted);
            cursor: pointer; transition: all .12s; user-select: none;
        }
        .sl-scope-chip input { display: none; }
        .sl-scope-chip.checked { background: var(--action); border-color: var(--action); color: #fff; }
        .sl-scope-chip:not(.checked):hover { border-color: var(--action); color: var(--action); }

        /* Action buttons */
        #sl-actions {
            padding: 12px 14px;
            border-top: 1px solid var(--line-soft);
            display: flex; flex-direction: column; gap: 6px;
            flex-shrink: 0;
        }
        #sl-actions button { width: 100%; }

        /* ── CSS editor tab ──────────────────────────────────── */
        #sl-file-list {
            list-style: none;
            border: 1px solid var(--line);
            border-radius: 6px;
            overflow: hidden;
            flex-shrink: 0;
        }
        .sl-file-item {
            display: flex; align-items: center;
            padding: 7px 10px; font-size: 12px;
            color: var(--muted); cursor: pointer;
            font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
            border-bottom: 1px solid var(--line-soft);
            transition: background .1s;
        }
        .sl-file-item:last-child { border-bottom: none; }
        .sl-file-item:hover { background: #f0fdfd; color: var(--ink); }
        .sl-file-item.active { background: #e0f7f7; color: var(--action-dark); font-weight: 600; }
        .sl-file-ext { font-size: 10px; margin-left: auto; opacity: .5; }
        .sl-file-empty { padding: 12px; text-align: center; color: var(--muted); font-size: 12px; }

        /* Editor surface with syntax highlight overlay */
        .sl-editor-wrap {
            flex: 1; position: relative; overflow: hidden;
            border: 1px solid var(--line); border-radius: 6px;
            font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
            font-size: 12px; line-height: 1.65;
        }
        #sl-css-highlight {
            position: absolute; inset: 0;
            padding: 10px; margin: 0;
            overflow: auto; pointer-events: none;
            white-space: pre; word-wrap: normal;
            background: #f6f8fa; color: #24292e;
            font: inherit; border: none;
        }
        #sl-css-textarea {
            position: absolute; inset: 0;
            padding: 10px; width: 100%; height: 100%;
            font: inherit; background: transparent;
            color: transparent; caret-color: #333;
            border: none; resize: none; outline: none;
            overflow: auto; white-space: pre; word-wrap: normal;
            z-index: 1;
        }
        .sl-editor-toolbar {
            display: flex; gap: 5px; align-items: center;
            padding: 6px 0; flex-shrink: 0;
        }
        .sl-editor-toolbar { gap: 6px; }
        .sl-modified-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: #f9c23c; display: none; margin-left: auto;
        }
        .sl-modified-dot.on { display: block; }
        .sl-editor-file-label {
            font-size: 10px; color: var(--muted); font-family: monospace; flex: 1;
        }

        /* ── Quick settings tab ──────────────────────────────── */
        details {
            border: 1px solid var(--line-soft);
            border-radius: 6px;
            overflow: hidden;
        }
        summary {
            padding: 9px 12px;
            font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .5px;
            cursor: pointer; user-select: none;
            background: #f8fafc; color: var(--muted);
            list-style: none;
            display: flex; align-items: center; gap: 6px;
        }
        summary:hover { color: var(--ink); }
        summary::after { content: '▾'; margin-left: auto; }
        details[open] summary::after { content: '▴'; }
        details[open] summary { color: var(--action); }
        .sl-quick-body {
            padding: 10px 12px;
            display: flex; flex-direction: column; gap: 8px;
            background: #fff;
        }
        .sl-quick-row {
            display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ink);
        }
        .sl-quick-row label { flex: 1; color: var(--muted); font-size: 11px; }
        .sl-quick-row input[type="color"] {
            width: 36px; height: 26px; padding: 1px 2px;
            border: 1px solid var(--line); border-radius: 4px; cursor: pointer;
        }
        .sl-quick-row input[type="number"],
        .sl-quick-row select {
            width: 90px; padding: 4px 6px;
            border: 1px solid var(--line); border-radius: 4px;
            font-size: 12px;
        }
        .sl-quick-row input[type="checkbox"] { accent-color: var(--action); }

        /* ── Right: Preview ──────────────────────────────────── */
        #sl-preview-area {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
        }
        #sl-preview-toolbar {
            display: flex; align-items: center; gap: 8px;
            padding: 6px 12px;
            background: #f8fafc; border-bottom: 1px solid var(--line);
            flex-shrink: 0;
        }
        .sl-vp-btn.active { background: var(--gray-800) !important; border-color: var(--gray-800) !important; color: #fff !important; }
        .sl-scope-sep { width: 1px; height: 18px; background: var(--line); margin: 0 2px; margin-left: auto; }
        .sl-scope-label { font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: .5px; white-space: nowrap; }
        #btn-inspect.active { background: var(--brand-primary) !important; border-color: var(--brand-primary) !important; color: #fff !important; }
        #sl-status {
            font-size: 11px; color: var(--muted);
            padding: 0 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px;
        }
        #sl-iframe-wrap {
            flex: 1; display: flex; align-items: center; justify-content: center;
            background: var(--bg); overflow: auto; padding: 0;
        }
        #sl-iframe-wrap.vp-tablet  { padding: 16px; }
        #sl-iframe-wrap.vp-mobile  { padding: 32px; }
        #sl-iframe {
            width: 100%; height: 100%; border: none; background: #fff;
        }
        #sl-iframe-wrap.vp-tablet #sl-iframe { max-width: 768px; border-radius: 4px; box-shadow: 0 4px 24px rgba(0,0,0,.15); }
        #sl-iframe-wrap.vp-mobile #sl-iframe { max-width: 390px; border-radius: 8px; box-shadow: 0 4px 24px rgba(0,0,0,.2); }
        #sl-placeholder {
            display: flex; flex-direction: column; align-items: center;
            justify-content: center; gap: 10px;
            color: var(--muted); font-size: 14px; width: 100%;
        }
        #sl-placeholder svg { opacity: .25; }
        body.sl-inspect #sl-iframe { cursor: crosshair; }

        /* ── Loading overlay ─────────────────────────────────── */
        #sl-loading-overlay {
            display: none;
            position: absolute; inset: 0;
            background: rgba(238,241,244,.82);
            backdrop-filter: blur(2px);
            z-index: 10;
            flex-direction: column;
            align-items: center; justify-content: center;
            gap: 14px; color: var(--muted); font-size: 13px;
        }
        #sl-loading-overlay.visible { display: flex; }
        .sl-spinner {
            width: 36px; height: 36px;
            border: 3px solid var(--line);
            border-top-color: var(--action);
            border-radius: 50%;
            animation: sl-spin .7s linear infinite;
        }
        @keyframes sl-spin { to { transform: rotate(360deg); } }

        /* ── Click-to-edit modal ─────────────────────────────── */
        #sl-click-modal {
            position: fixed; top: 80px; right: 20px;
            width: 280px; background: #fff;
            border: 1px solid var(--line); border-radius: 8px;
            box-shadow: 0 8px 32px rgba(0,0,0,.18);
            display: none; flex-direction: column; z-index: 100;
        }
        #sl-click-modal.open { display: flex; }
        #sl-click-modal-header {
            display: flex; align-items: center;
            padding: 8px 12px; background: #212529; color: #fff;
            border-radius: 7px 7px 0 0; cursor: move; user-select: none; gap: 8px;
        }
        #sl-click-modal-header span { font-size: 11px; font-weight: 600; flex: 1; }
        #sl-click-modal-close {
            background: none; border: none; color: #adb5bd;
            font-size: 16px; cursor: pointer; line-height: 1; padding: 0 2px;
        }
        #sl-click-modal-selector {
            font-family: monospace; font-size: 11px;
            background: #f3f4f6; color: var(--action-dark);
            padding: 6px 12px; border-bottom: 1px solid var(--line-soft);
            word-break: break-all;
        }
        #sl-click-modal-body {
            padding: 10px 12px;
            display: flex; flex-direction: column; gap: 8px;
        }
        .sl-click-row {
            display: flex; align-items: center; gap: 8px; font-size: 11px;
        }
        .sl-click-row label { flex: 1; color: var(--muted); }
        .sl-click-row input[type="color"] {
            width: 34px; height: 24px; padding: 1px 2px;
            border: 1px solid var(--line); border-radius: 4px; cursor: pointer;
        }
        .sl-click-row input[type="number"],
        .sl-click-row select {
            width: 80px; padding: 3px 5px;
            border: 1px solid var(--line); border-radius: 4px; font-size: 11px;
        }
        #sl-click-modal-footer {
            padding: 8px 12px; display: flex; gap: 6px;
            border-top: 1px solid var(--line-soft);
        }
        #sl-click-modal-footer button {
            flex: 1; padding: 5px; border-radius: 5px;
            font-size: 11px; font-weight: 500; cursor: pointer;
            border: 1px solid transparent; transition: all .12s;
        }
        #btn-click-apply { background: var(--action); color: #fff; }
        #btn-click-apply:hover { background: var(--action-dark); }
        #btn-click-cancel { background: #fff; border-color: var(--line); color: var(--muted); }
        #btn-click-cancel:hover { color: var(--ink); }

        .sl-loading { opacity: .6; pointer-events: none; }

        /* ── Files tab ───────────────────────────────────────── */
        .sl-rename-warning {
            background: #fff8e1; border: 1px solid #f9c23c;
            border-radius: 6px; padding: 8px 10px;
            font-size: 11px; color: #7a5a00; line-height: 1.5;
        }
        .sl-rename-row {
            display: flex; flex-direction: column; gap: 4px;
        }
        .sl-rename-row label {
            font-size: 10px; font-weight: 700; text-transform: uppercase;
            letter-spacing: .5px; color: var(--muted);
        }
        .sl-rename-row input,
        .sl-rename-row select,
        .sl-rename-row textarea {
            padding: 7px 9px; border: 1px solid var(--line); border-radius: 6px;
            font-size: 12px; color: var(--ink);
        }
        .sl-rename-row textarea { min-height: 70px; resize: vertical; }
        .sl-rename-row input:focus,
        .sl-rename-row select:focus,
        .sl-rename-row textarea:focus {
            outline: none; border-color: var(--action);
            box-shadow: 0 0 0 3px rgba(11,161,161,.12);
        }
        .sl-rename-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .sl-rename-hint { font-size: 10px; color: var(--muted); }
        .sl-rename-error {
            background: #fee2e2; border: 1px solid #fca5a5;
            border-radius: 5px; padding: 6px 10px;
            font-size: 11px; color: #b91c1c;
        }
        .sl-upload-row {
            display: flex; align-items: center; gap: 8px;
        }
        .sl-upload-name {
            font-size: 11px; color: var(--muted); flex: 1;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .sl-section-divider {
            font-size: 10px; font-weight: 700; text-transform: uppercase;
            letter-spacing: .6px; color: var(--muted);
            padding-bottom: 4px; border-bottom: 1px solid var(--line-soft);
        }
        #btn-files-install:disabled, #btn-files-download:disabled,
        #btn-files-upload-install:disabled { opacity: .4; cursor: not-allowed; }
    </style>
</head>
<body>

<!-- ── Header ── -->
<div id="sl-header">
    <a id="sl-back-link" href="{{ basePath }}/workarea">← {{ t.sl_back or 'Back to editor' }}</a>
    <span class="sep">/</span>
    <h1>Style Lab</h1>
    <span id="sl-badge">dev</span>
</div>

<!-- ── Main shell ── -->
<div id="sl-shell">

    <!-- ── Left panel ── -->
    <div id="sl-panel">
        <div class="sl-tabs">
            <button class="sl-tab active" data-tab="controls" data-testid="sl-tab-controls">{{ t.sl_tab_settings or 'Settings' }}</button>
            <button class="sl-tab" data-tab="css" data-testid="sl-tab-css">CSS</button>
            <button class="sl-tab" data-tab="quick" data-testid="sl-tab-quick">Quick</button>
            <button class="sl-tab" data-tab="files" data-testid="sl-tab-files">{{ t.sl_tab_files or 'Files' }}</button>
        </div>

        <!-- ── Controls tab ── -->
        <div class="sl-tab-panel active" data-panel="controls">
            <div class="sl-panel-scroll">
                <div class="sl-section">
                    <span class="sl-label">{{ t.sl_project or 'Project' }}</span>
                    <select id="sl-fixture" data-testid="style-lab-fixture">
                        <option value="">— select —</option>
                    </select>
                    <span id="sl-fixture-hint" style="font-size:10px;color:var(--muted);margin-top:3px;display:block;">
                        {{ t.sl_project_hint or 'Open a project in eXeLearning to see it here.' }}
                    </span>
                </div>
                <div class="sl-section" id="sl-theme-section">
                    <span class="sl-label">Theme</span>
                    <select id="sl-theme" data-testid="style-lab-theme">
                        <option value="">— loading —</option>
                    </select>
                </div>
                <div class="sl-section">
                    <span class="sl-label">Export type</span>
                    <div class="sl-btn-group" data-testid="style-lab-export-type">
                        <button class="active" data-export="html5">Website</button>
                        <button data-export="html5-sp">Single</button>
                        <button data-export="scorm12">SCORM</button>
                    </div>
                </div>
                <div class="sl-section">
                    <span class="sl-label">Export options</span>
                    <div class="sl-options-grid" data-testid="style-lab-export-options">
                        <label class="sl-option"><input type="checkbox" data-meta="addSearchBox" data-testid="opt-searchBox"> Search box</label>
                        <label class="sl-option"><input type="checkbox" data-meta="addPagination" data-testid="opt-pagination"> Page counter</label>
                        <label class="sl-option"><input type="checkbox" data-meta="addAccessibilityToolbar" data-testid="opt-accessibility"> Accessibility toolbar</label>
                        <label class="sl-option"><input type="checkbox" data-meta="addExeLink" checked data-testid="opt-exeLink"> eXeLearning link</label>
                        <label class="sl-option"><input type="checkbox" data-meta="exportSource" checked data-testid="opt-exportSource"> Include source</label>
                    </div>
                </div>
            </div>
            <div style="padding:12px 14px;border-top:1px solid var(--line-soft);flex-shrink:0;">
                <button id="btn-goto-files" class="btn button-display" data-testid="style-lab-export-theme" style="width:100%;">✓ {{ t.sl_goto_files or 'Export / install theme...' }}</button>
            </div>
        </div>

        <!-- ── CSS editor tab ── -->
        <div class="sl-tab-panel" data-panel="css">
            <div class="sl-panel-scroll" style="gap:10px;">
                <ul id="sl-file-list">
                    <li class="sl-file-empty">{{ t.sl_file_list_empty or 'Load a project and theme first.' }}</li>
                </ul>
                <div class="sl-editor-toolbar">
                    <span class="sl-editor-file-label" id="sl-editor-file-label">style.css</span>
                    <div class="sl-modified-dot" id="sl-modified-dot" title="{{ t.sl_unsaved_changes or 'Unsaved changes' }}"></div>
                </div>
                <div class="sl-editor-wrap" style="min-height:260px;">
                    <pre id="sl-css-highlight"><code class="language-css"></code></pre>
                    <textarea id="sl-css-textarea" spellcheck="false" wrap="off" placeholder="{{ t.sl_css_placeholder or 'Load a project and theme to edit CSS...' }}"></textarea>
                </div>
                <div class="sl-editor-toolbar">
                    <button id="btn-apply-css" class="btn button-display">{{ t.sl_apply_css or 'Apply' }}</button>
                    <button id="btn-reset-css" class="btn button-tertiary">{{ t.sl_reset_css or 'Reset' }}</button>
                    <button id="btn-wrap-scope" class="btn button-tertiary" title="{{ t.sl_wrap_scope or 'Wrap scope' }}">{{ t.sl_wrap_scope or 'Wrap scope' }}</button>
                </div>
            </div>
        </div>

        <!-- ── Quick settings tab ── -->
        <div class="sl-tab-panel" data-panel="quick">
            <div class="sl-panel-scroll">
                <details open>
                    <summary>{{ t.sl_general_appearance or 'General appearance' }}</summary>
                    <div class="sl-quick-body">
                        <div class="sl-quick-row"><label>{{ t.sl_link_color or 'Link color' }}</label><input type="color" data-quick="linkColor" value="#d76b4a"></div>
                        <div class="sl-quick-row"><label>{{ t.sl_page_title_color or 'Page title color' }}</label><input type="color" data-quick="titleColor" value="#078e8e"></div>
                        <div class="sl-quick-row"><label>{{ t.sl_text_color or 'Text color' }}</label><input type="color" data-quick="textColor" value="#333333"></div>
                        <div class="sl-quick-row"><label>{{ t.sl_content_bg or 'Content background' }}</label><input type="color" data-quick="contentBgColor" value="#ffffff"></div>
                        <div class="sl-quick-row"><label>{{ t.sl_page_bg or 'Page background' }}</label><input type="color" data-quick="pageBgColor" value="#ffffff"></div>
                        <div class="sl-quick-row"><label>{{ t.sl_outer_bg or 'Outer background' }}</label><input type="color" data-quick="contentOuterBgColor" value="#eef1f4"></div>
                    </div>
                </details>
                <details>
                    <summary>{{ t.sl_typography or 'Typography' }}</summary>
